<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <AssemblyName>Kronos.Forecasting</AssemblyName>
        <PackageId>Kronos.Forecasting</PackageId>
        <Description>Native .NET inference for the Kronos K-line foundation model. Requires Kronos.Forecasting.Weights.*</Description>
        <PackageTags>kronos;timeseries;forecasting;transformer;torchsharp;ohlcv;kline</PackageTags>
        <IsPackable>true</IsPackable>

        <RootNamespace>Kronos.Forecasting</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Kronos.Forecasting.Tests" />
    </ItemGroup>

    <ItemGroup>
        <!-- Managed only. The native runtime is a runtime concern, so every executable
             picks its own: TorchSharp-cpu, TorchSharp-cuda-linux or TorchSharp-cuda-windows.
             See https://github.com/dotnet/TorchSharp#download -->
        <PackageReference Include="TorchSharp" Version="0.107.0" />
    </ItemGroup>

</Project>
