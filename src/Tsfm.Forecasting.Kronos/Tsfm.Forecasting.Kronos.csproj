<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <AssemblyName>Tsfm.Forecasting.Kronos</AssemblyName>
        <PackageId>Tsfm.Forecasting.Kronos</PackageId>
        <Description>Native .NET inference for the Kronos K-line foundation model. Requires Tsfm.Forecasting.Kronos.Weights.*</Description>
        <PackageTags>kronos;timeseries;forecasting;transformer;torchsharp;ohlcv;kline</PackageTags>
        <IsPackable>true</IsPackable>

        <RootNamespace>Tsfm.Forecasting.Kronos</RootNamespace>
            <PackageLicenseExpression>MIT</PackageLicenseExpression>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Tsfm.Forecasting.Kronos.Tests" />
    </ItemGroup>

    <ItemGroup>
        <!-- Managed only. The native runtime is a runtime concern, so every executable
             picks its own: TorchSharp-cpu, TorchSharp-cuda-linux or TorchSharp-cuda-windows.
             See https://github.com/dotnet/TorchSharp#download -->
        <PackageReference Include="TorchSharp" Version="0.107.0" />
    </ItemGroup>


    <ItemGroup>
        <ProjectReference Include="..\Tsfm.Forecasting\Tsfm.Forecasting.csproj" />
    </ItemGroup>

</Project>
