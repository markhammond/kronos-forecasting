<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <RootNamespace>Tsfm.Forecasting.Kronos.Parity</RootNamespace>
        <!-- A development gate, not a shipped artefact. -->
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <!--
        Checks Genotype.Kronos against tensors exported from the reference
        implementation. Kept out of the test project because the fixtures it reads are
        large and the comparison is a development gate, not a per-commit assertion.
    -->

    <ItemGroup>
        <PackageReference Include="TorchSharp-cpu" Version="0.107.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Tsfm.Forecasting.Kronos\Tsfm.Forecasting.Kronos.csproj" />
    </ItemGroup>

</Project>
